[Unit]
Description=Minecraft AI town decider (llama-server)
After=network-online.target

[Service]
# 2本並行（判断係と考える係）。文脈は1本あたり 4096 トークン（大きくするとメモリ不足で落ちる）
User=mcai
Group=mcai
EnvironmentFile=/etc/default/minecraft-ai-town
ExecStart=/opt/llm/llama.cpp/build/bin/llama-server -m ${LLM_MODEL} --host 127.0.0.1 --port ${LLM_PORT} -t ${LLM_THREADS} -c 8192 -np 2 --cache-reuse 256
Restart=always
RestartSec=10
# bot やマイクラより後回しでよい
Nice=10

[Install]
WantedBy=multi-user.target
