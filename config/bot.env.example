# /etc/default/minecraft-ai-town にコピーして使う
MC_HOST=192.0.2.10
MC_PORT=25565
MC_VERSION=1.21.4
BOT_NAME=ai_builder_01
DATA_DIR=/var/lib/minecraft-ai-town

# 判断係（llama-server）。scripts/setup-llm.sh で用意する。off にすると LLM を使わずルールで動く
LLM_URL=http://127.0.0.1:8081
LLM_PORT=8081
LLM_MODEL=/opt/llm/models/Qwen_Qwen3.5-4B-Q4_K_M.gguf
LLM_THREADS=12

# 考える係だけ別のマシンの大きいモデルを使うとき（空なら LLM_URL と同じ）
THINKER_URL=
